# ===================== REFERENCE ENGINE =====================
notes <- list()
add <- function(id, topic, keys, when, inputs, code, interpret) {
  notes[[id]] <<- list(topic=topic, keys=keys, when=when, inputs=inputs, code=code, interpret=interpret)
}
check_vec <- function(v, n=1) {
  if (!is.numeric(v) || length(v)<n || any(!is.finite(v))) stop("Enter enough finite numeric values in the input section.", call.=FALSE)
}
check_xy <- function(x,y) {
  check_vec(x,2); check_vec(y,2)
  if (length(x)!=length(y)) stop("x and y must contain the same number of paired observations.", call.=FALSE)
}
check_p <- function(v,p) {
  check_vec(v); check_vec(p)
  if (length(v)!=length(p) || any(p<0) || abs(sum(p)-1)>1e-8) stop("Each outcome needs a probability; probabilities must be nonnegative and sum to 1.", call.=FALSE)
}
fit_xy <- function(x,y) {
  check_xy(x,y)
  if (var(x)==0) stop("OLS slope requires variation in x.", call.=FALSE)
  lm(y ~ x)
}
load_data <- function() {
  if (!requireNamespace("wooldridge",quietly=TRUE)) stop('Before the exam, run install.packages("wooldridge").',call.=FALSE)
  e <- new.env(); data(list=dataset_name,package="wooldridge",envir=e)
  if (!exists(dataset_name,envir=e,inherits=FALSE)) stop("Dataset not found. Check dataset_name.",call.=FALSE)
  get(dataset_name,envir=e,inherits=FALSE)
}
data_xy <- function(d) {
  if (!all(c(x_col,y_col)%in%names(d))) stop("Check x_col and y_col against names(load_data()).",call.=FALSE)
  v <- data.frame(x=d[[x_col]],y=d[[y_col]]); v[complete.cases(v),,drop=FALSE]
}
data_fit <- function(d) { v <- data_xy(d); fit_xy(v$x,v$y) }
normalize <- function(s) {
  s <- gsub("r[[:space:]]*\\^[[:space:]]*2","r2",gsub("\u00b2","2",tolower(s)))
  trimws(gsub("[^a-z0-9]+"," ",s))
}
list_notes <- function() {
  print(data.frame(ID=names(notes),TOPIC=vapply(notes,`[[`,"", "topic")),row.names=FALSE)
  invisible(names(notes))
}
find_note <- function(search, max_results=3) {
  if (length(search)!=1 || is.na(search) || !nzchar(trimws(search))) { list_notes(); return(invisible(character())) }
  q <- normalize(search); words <- unique(strsplit(q," +")[[1]])
  words <- setdiff(words,c("a","an","the","of","to","in","for","is","are","and","or","what","which","find","calculate","compute","with","from","between","that","this","it","does","x","y"))
  score <- vapply(names(notes),function(id) {
    z <- notes[[id]]; title <- strsplit(normalize(z$topic)," +")[[1]]
    key <- strsplit(normalize(z$keys)," +")[[1]]; use <- strsplit(normalize(z$when)," +")[[1]]
    aliases <- vapply(strsplit(z$keys,";",fixed=TRUE)[[1]],normalize,"")
    4*sum(words%in%title)+2*sum(words%in%key)+sum(words%in%use)+12*as.integer(q%in%c(normalize(id),normalize(z$topic),aliases))
  },numeric(1))
  if (search%in%names(notes)) ids <- search else ids <- names(sort(score[score>0 & score>=max(score)*0.5],decreasing=TRUE))
  if (!length(ids)) { cat("No match. Try a short keyword or list_notes().\n"); return(invisible(character())) }
  shown <- head(ids,max_results)
  for (id in shown) {
    z <- notes[[id]]
    cat("\n--- ",z$topic," [",id,"] ---\nUSE WHEN: ",z$when,"\nCHANGE: ",if(nzchar(z$inputs))z$inputs else "No inputs", "\nRUN: ",if(nzchar(z$code))z$code else "Concept only", "\nINTERPRET: ",z$interpret,"\n",sep="")
    if (nzchar(z$code)) cat('SHORTCUT: run_note("',id,'")\n',sep="")
  }
  if (length(ids)>length(shown)) cat("\nMore matches exist; narrow your wording or increase max_results.\n")
  invisible(shown)
}
run_note <- function(id, round_to=digits, envir=parent.frame()) {
  if (length(id)!=1 || !id%in%names(notes)) stop('Use an exact ID from find_note() or list_notes().',call.=FALSE)
  z <- notes[[id]]
  if (!nzchar(z$code)) { find_note(id); return(invisible(NULL)) }
  vars <- trimws(strsplit(z$inputs,",",fixed=TRUE)[[1]])
  for (v in vars[nzchar(vars)]) {
    val <- get(v,envir=envir,inherits=TRUE)
    if (!length(val) || anyNA(val) || (is.numeric(val)&&any(!is.finite(val)))) stop(paste("Fill in input:",v),call.=FALSE)
  }
  ans <- eval(parse(text=z$code),envir=new.env(parent=envir))
  if (!is.null(round_to) && is.numeric(ans)) ans <- round(ans,round_to)
  if (!is.null(round_to) && is.data.frame(ans)) ans[] <- lapply(ans,function(v) if(is.numeric(v))round(v,round_to) else v)
  print(ans); invisible(ans)
}

